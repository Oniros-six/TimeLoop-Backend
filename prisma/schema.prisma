generator customer {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//* =========================================
//* Enums
//* =========================================

enum BillingTypes {
  FLEXIBLE
  FLAT
  FREE
}

enum BusinessCategory {
  Peluqueria
  Barberia
  Estetica
  Spa
  Salon
  Masajes
  Otro
}

enum Roles {
  ADMIN
  EMPLOYEE
}

enum AvailabilityType {
  full
  half
  off
}

enum ReminderChannel {
  email
  whatsapp
  sms
}

enum ReminderStatus {
  pending
  sent
  failed
  canceled
}

enum EntityType {
  BOOKING
  CUSTOMER
  USER
  COMMERCE
  SERVICE
  USER_CONFIG
  COMMERCE_CONFIG
  USER_WORKING_OVERRIDE
  COMMERCE_WORKING_OVERRIDE
  USER_WORKING_PATTERN
  COMMERCE_WORKING_PATTERN
  INVOICE
  PAYMENT
}

enum ChangeType {
  CREATED
  UPDATED
  CANCELED
  SUSPENDED
  REINSTATED
}

enum WeekDays {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
  NO_SHOW
  COMPLETED
  RESCHEDULED
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
}

enum PaymentMethod {
  MERCADO_PAGO
  CASH
  // CRYPTO
  // PAYPAL
  // STRIPE
  // BANK_TRANSFER
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

enum Currency {
  UYU
  USD
  EUR
}

//* =========================================
//* Core
//* =========================================
model Commerce {
  id               Int              @id @default(autoincrement())
  logo             String           @default("")
  name             String
  email            String           @unique
  phone            String           @unique
  address          String
  businessCategory BusinessCategory
  active           Boolean

  logs             ActivityLog[]             @relation("CommerceLogs")
  bookings         Booking[]                 @relation("CommerceBookings")
  config           CommerceConfig?           @relation("CommerceConfig")
  overridePatterns CommerceWorkingOverride[] @relation("CommerceOverridePatterns")
  workingPatterns  CommerceWorkingPattern[]  @relation("CommerceWorkingPatterns")
  reminders        Reminder[]                @relation("CommerceReminders")
  users            User[]                    @relation("CommerceUsers")
  Invoice          Invoice[]
  Payment          Payment[]
  CustomerCommerce CustomerCommerce[]

  @@map("commerces")
}

model Customer {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  phone            String
  logs             ActivityLog[]      @relation("CustomerLogs")
  bookings         Booking[]          @relation("CustomerBookings")
  reminders        Reminder[]         @relation("CustomerReminders")
  BookingHistory   BookingHistory[]
  CustomerCommerce CustomerCommerce[]

  @@map("customers")
}

model User {
  id               Int                   @id @default(autoincrement())
  name             String
  email            String                @unique
  phone            String?               @unique
  password         String
  role             Roles
  commerceId       Int
  active           Boolean
  logs             ActivityLog[]         @relation("UserLogs")
  bookings         Booking[]             @relation("UserBookings")
  services         Service[]             @relation("UserServices")
  config           UserConfig?           @relation("UserConfig")
  overridePatterns UserWorkingOverride[] @relation("UserOverridePatterns")
  workingPatterns  UserWorkingPattern[]  @relation("UserWorkingPatterns")
  commerce         Commerce              @relation("CommerceUsers", fields: [commerceId], references: [id])
  BookingHistory   BookingHistory[]

  @@map("users")
}

model Booking {
  id         Int           @id @default(autoincrement())
  duration   Int
  customerId Int
  commerceId Int
  userId     Int
  totalPrice Float
  notes      String
  status     BookingStatus
  timeEnd    DateTime      @db.Timestamptz
  timeStart  DateTime      @db.Timestamptz

  bookingServices BookingService[]
  bookingHistory  BookingHistory?
  commerce        Commerce         @relation("CommerceBookings", fields: [commerceId], references: [id])
  customer        Customer         @relation("CustomerBookings", fields: [customerId], references: [id])
  user            User             @relation("UserBookings", fields: [userId], references: [id])
  Payment         Payment[]

  @@map("bookings")
}

model Service {
  id              Int              @id @default(autoincrement())
  name            String
  description     String           @default("")
  price           Float
  durationMinutes Int
  userId          Int
  bookingServices BookingService[]
  user            User             @relation("UserServices", fields: [userId], references: [id])

  @@map("services")
}

model BookingService {
  bookingId Int
  serviceId Int
  id        Int     @id @default(autoincrement())
  booking   Booking @relation(fields: [bookingId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@map("booking_services")
}

//* =========================================
//* Configs
//* =========================================

model CommerceConfig {
  id                          Int             @id @default(autoincrement())
  commerceId                  Int             @unique
  cancellationDeadlineMinutes Int
  billingType                 BillingTypes
  welcomeMessage              String
  acceptedPaymentMethods      PaymentMethod[]

  commerce Commerce @relation("CommerceConfig", fields: [commerceId], references: [id])

  @@map("commerce_configs")
}

model UserConfig {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserConfig", fields: [userId], references: [id])

  @@map("user_configs")
}

//* =========================================
//* Working Patterns
//* =========================================

model UserWorkingPattern {
  id               Int              @id @default(autoincrement())
  userId           Int
  weekday          WeekDays
  availabilityType AvailabilityType
  morningStart     String?
  morningEnd       String?
  afternoonStart   String?
  afternoonEnd     String?
  user             User             @relation("UserWorkingPatterns", fields: [userId], references: [id])

  @@map("user_working_patterns")
}

model CommerceWorkingPattern {
  id               Int              @id @default(autoincrement())
  commerceId       Int
  weekday          WeekDays
  availabilityType AvailabilityType
  morningStart     String?
  morningEnd       String?
  afternoonStart   String?
  afternoonEnd     String?
  commerce         Commerce         @relation("CommerceWorkingPatterns", fields: [commerceId], references: [id])

  @@map("commerce_working_patterns")
}

//* =========================================
//* Working override
//* =========================================

model UserWorkingOverride {
  id             Int              @id @default(autoincrement())
  userId         Int
  date           DateTime         @db.Timestamptz
  overrideType   AvailabilityType
  morningStart   String?
  morningEnd     String?
  afternoonStart String?
  afternoonEnd   String?
  notes          String
  user           User             @relation("UserOverridePatterns", fields: [userId], references: [id])

  @@map("user_working_overrides")
}

model CommerceWorkingOverride {
  id             Int              @id @default(autoincrement())
  commerceId     Int
  date           DateTime         @db.Timestamptz
  overrideType   AvailabilityType
  morningStart   String?
  morningEnd     String?
  afternoonStart String?
  afternoonEnd   String?
  notes          String
  commerce       Commerce         @relation("CommerceOverridePatterns", fields: [commerceId], references: [id])

  @@map("commerce_working_overrides")
}

//* =========================================
//* logging, History, Invoices and Reminders
//* =========================================
model ActivityLog {
  id         Int        @id @default(autoincrement())
  entityId   Int
  userId     Int?
  commerceId Int?
  customerId Int?
  entityType EntityType
  changeType ChangeType
  detail     String
  timestamp  DateTime   @default(now()) @db.Timestamptz
  commerce   Commerce?  @relation("CommerceLogs", fields: [commerceId], references: [id])
  customer   Customer?  @relation("CustomerLogs", fields: [customerId], references: [id])
  user       User?      @relation("UserLogs", fields: [userId], references: [id])

  @@map("activity_logs")
}

model Reminder {
  id          Int             @id @default(autoincrement())
  bookingId   Int             @unique
  customerId  Int
  commerceId  Int
  channel     ReminderChannel
  status      ReminderStatus
  scheduledAt DateTime        @db.Timestamptz
  sentAt      DateTime?       @db.Timestamptz
  commerce    Commerce        @relation("CommerceReminders", fields: [commerceId], references: [id])
  customer    Customer        @relation("CustomerReminders", fields: [customerId], references: [id])

  @@map("reminders")
}

model BookingHistory {
  id                Int           @id @default(autoincrement())
  bookingId         Int           @unique
  commerceId        Int
  userId            Int
  customerId        Int
  priceAtBooking    Float
  durationAtBooking Int
  timeStart         DateTime      @db.Timestamptz
  timeEnd           DateTime      @db.Timestamptz
  status            BookingStatus
  notes             String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@map("booking_histories")
}

model Invoice {
  id         Int @id @default(autoincrement())
  commerceId Int

  periodStart DateTime @db.Timestamptz
  periodEnd   DateTime @db.Timestamptz

  totalBookings Int @default(0)
  totalCanceled Int @default(0)

  totalIncome Float @default(0.0) // ingreso bruto

  feePercentage Float @default(0.0) // porcentaje del total income
  serviceFee    Float @default(0.0) // monto a cobrar

  status InvoiceStatus @default(PENDING)

  generatedAt DateTime @default(now()) @db.Timestamptz

  commerce Commerce @relation(fields: [commerceId], references: [id])

  @@index([commerceId, periodStart, periodEnd])
}

//* =========================================
//* Payment
//* =========================================

model Payment {
  id          Int           @id @default(autoincrement())
  bookingId   Int
  commerceId  Int
  amount      Float
  currency    Currency      @default(UYU)
  status      PaymentStatus @default(pending)
  method      PaymentMethod
  providerRef String? // referencia de MercadoPago u otro proveedor
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime?     @updatedAt @db.Timestamptz
  refundedAt  DateTime?     @db.Timestamptz

  Commerce Commerce @relation(fields: [commerceId], references: [id])
  Booking  Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([commerceId])
}

model MercadoPago {
  id           Int      @id @default(autoincrement())
  commerceId   Int      @unique
  accessToken  String
  refreshToken String
  publicKey    String?
  mpUserId     String
  tokenExpires DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
}

//* =========================================
//* Metrics
//* =========================================

model CustomerCommerce {
  id                 Int      @id @default(autoincrement())
  customerId         Int
  commerceId         Int
  firstReservationAt DateTime @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])
  commerce Commerce @relation(fields: [commerceId], references: [id])

  @@unique([customerId, commerceId])
}
